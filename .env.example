# ---------- Supabase ----------
# The service-role key is server-only. It is never exposed to the browser and
# must never be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Vaani webhook ----------
# Shared secret configured on the Vaani side. Requests whose HMAC-SHA256
# signature does not match are rejected with 401 and never written.
VAANI_WEBHOOK_SECRET=
# Optional: set to "true" ONLY in local development to skip signature checks.
VAANI_ALLOW_UNSIGNED=false

# ---------- Email handoff (Resend) ----------
# With RESEND_API_KEY unset the app runs in dry-run: it renders the exact email
# and records the handoff, but sends nothing. Nothing crashes, nothing is lost.
RESEND_API_KEY=
EMAIL_FROM="Aangan Enquiries <enquiries@aanganstudio.in>"
# Designers' shared inbox. Gets qualified leads WITHOUT the phone number.
HANDOFF_TO=
# Escalations land here. No claim link on these.
ESCALATION_TO=
# Founder. Gets pricing-leak incidents and the daily digest.
FOUNDER_TO=

# ---------- Links and auth ----------
# Used to build absolute "Open record" and claim links inside emails.
APP_BASE_URL=http://localhost:3000
# Signs one-click claim/pass links. Rotate and every outstanding link dies.
CLAIM_LINK_SECRET=
# Bearer token for /api/cron/*. Required on Hobby, where the 30-minute sweep
# is driven by an external scheduler.
CRON_SECRET=
# Protects /dashboard. Unset means the dashboard is open - fine locally, not in production.
DASHBOARD_PASSWORD=

# ---------- Office hours ----------
OFFICE_TZ=Asia/Kolkata
OFFICE_OPEN_HOUR=10
OFFICE_CLOSE_HOUR=19
